    {
      "id": 14,
      "type": "timeseries",
      "title": "Minor GC pause latency — live (µs)",
      "description": "p50 / p95 / p99 of the last 256 minor GC pauses, sampled every 5 s heartbeat. Under Boehm all lines are 0. Under the generational backend these tick up as the nursery fills.",
      "datasource": { "type": "influxdb", "uid": "P951FEA4DE68E13C5" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 32 },
      "options": {
        "legend": { "displayMode": "list", "placement": "right", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" },
        "spanNulls": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "decimals": 0,
          "custom": { "lineWidth": 2, "pointSize": 5, "showPoints": "always", "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "orange", "value": 2000 },
              { "color": "red",    "value": 5000 }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p50" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byName", "options": "p95" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "p99" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "P951FEA4DE68E13C5" },
          "refId": "A",
          "query": "from(bucket: \"benchmarks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"event\"] == \"heartbeat\" and (r[\"_field\"] == \"gc_pause_p50_us\" or r[\"_field\"] == \"gc_pause_p95_us\" or r[\"_field\"] == \"gc_pause_p99_us\"))\n  |> map(fn: (r) => ({ r with _field: if r._field == \"gc_pause_p50_us\" then \"p50\" else if r._field == \"gc_pause_p95_us\" then \"p95\" else \"p99\" }))\n  |> group(columns: [\"benchmark\", \"_field\"])\n  |> map(fn: (r) => ({ r with _field: r.benchmark + \" \" + r._field }))\n  |> group(columns: [\"_field\"])"
        }
