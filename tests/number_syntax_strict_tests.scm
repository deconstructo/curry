;;; string->number takes only Scheme number syntax, and the radix of
;;; string->number and number->string is checked (#410, #412).
;;;
;;; The text went to C's strtol and strtod, which accept leading white space
;;; and a "0x" prefix: (string->number " 5") was 5 and (string->number "0x10")
;;; was 16.0. (number->string 10 100) was a segmentation fault.

(define pass 0)
(define fail 0)
(define (check label got expected)
  (if (equal? got expected)
      (set! pass (+ pass 1))
      (begin (display "FAIL: ") (display label)
             (display " got ") (write got)
             (display " expected ") (write expected) (newline)
             (set! fail (+ fail 1)))))
(define (raises? thunk) (guard (e (#t #t)) (thunk) #f))
(define (s->n s . r) (apply string->number s r))

;;; ---- white space ----
(check "a leading space" (s->n " 5") #f)
(check "a leading tab" (s->n "\t5") #f)
(check "a leading newline" (s->n "\n1.5") #f)
(check "a leading space, signed" (s->n " +5") #f)
(check "a leading space, bignum" (s->n " 100000000000000000000") #f)
(check "a leading space, signed bignum" (s->n " +100000000000000000000") #f)
(check "a leading space after a prefix" (s->n "#x 10") #f)
(check "a leading space after #e" (s->n "#e 1.5") #f)
(check "a trailing space" (s->n "5 ") #f)
(check "a space after the sign" (s->n "+ 5") #f)
(check "a space inside" (s->n "1 000") #f)
(check "a space in a ratio" (s->n "1 /2") #f)
(check "a space after the slash" (s->n "1/ 2") #f)
(check "a space in a complex number" (s->n "1+ 2i") #f)
(check "a space in an exponent" (s->n "1e 2") #f)
(check "only a space" (s->n " ") #f)

;;; ---- the C 0x prefix ----
(check "0x10" (s->n "0x10") #f)
(check "0X10" (s->n "0X10") #f)
(check "-0x10" (s->n "-0x10") #f)
(check "+0x10" (s->n "+0x10") #f)
(check "a C hex float" (s->n "0x1p3") #f)
(check "0x10 in radix 16" (s->n "0x10" 16) #f)
(check "#x0x10" (s->n "#x0x10") #f)
(check "0x in a ratio numerator, radix 16" (s->n "0x10/2" 16) #f)
(check "0x in a ratio denominator" (s->n "1/0x10") #f)
(check "0x in an imaginary part" (s->n "1+0x10i") #f)
(check "0x in a real part" (s->n "0x10+1i") #f)
(check "0x with a big number" (s->n "0xFFFFFFFFFFFFFFFFFFFFFFFF" 16) #f)
(check "in radix 36, x is a digit" (s->n "0x10" 36) 42804)
(check "0x10 in source is a symbol" (symbol? '0x10) #t)
(check "an embedded NUL" (s->n (string #\1 #\2 (integer->char 0) #\3)) #f)

;;; ---- numbers that start with 0 are still numbers ----
(check "0" (s->n "0") 0)
(check "007" (s->n "007") 7)
(check "0.5" (s->n "0.5") 0.5)
(check "-0.5" (s->n "-0.5") -0.5)
(check "0/5" (s->n "0/5") 0)
(check "0e0" (s->n "0e0") 0.0)
(check "#x0" (s->n "#x0") 0)
(check "#x0f" (s->n "#x0f") 15)
(check "0f in radix 16" (s->n "0f" 16) 15)
(check "1e2" (s->n "1e2") 100.0)
(check "+5" (s->n "+5") 5)
(check "-5" (s->n "-5") -5)
(check "1/2" (s->n "1/2") 1/2)
(check "1+2i" (s->n "1+2i") (make-rectangular 1 2))
(check "+inf.0" (s->n "+inf.0") (/ 1.0 0))
(check "source literals" (list 0 007 0.5 -0.5 1e2 #x0f) (list 0 7 0.5 -0.5 100.0 15))

;;; ---- the radix of string->number ----
(check "radix 2" (s->n "101" 2) 5)
(check "radix 8" (s->n "17" 8) 15)
(check "radix 16" (s->n "ff" 16) 255)
(check "radix 36" (s->n "zz" 36) 1295)
(check "radix 3" (s->n "102" 3) 11)
(check "string->number radix 0" (raises? (lambda () (s->n "10" 0))) #t)
(check "string->number radix 1" (raises? (lambda () (s->n "10" 1))) #t)
(check "string->number radix 37" (raises? (lambda () (s->n "10" 37))) #t)
(check "string->number radix -2" (raises? (lambda () (s->n "10" -2))) #t)
(check "string->number radix 1.5" (raises? (lambda () (s->n "10" 1.5))) #t)
(check "string->number radix 10.0" (raises? (lambda () (s->n "10" 10.0))) #t)
(check "string->number radix a string" (raises? (lambda () (s->n "10" "x"))) #t)
(check "string->number radix a bignum" (raises? (lambda () (s->n "10" (expt 10 30)))) #t)
(check "the notation symbols still work" (s->n "1,0" 'neugebauer) 60)

;;; ---- the radix of number->string (#412: these crashed) ----
(check "number->string radix 2" (number->string 5 2) "101")
(check "number->string radix 16" (number->string 255 16) "ff")
(check "number->string radix 36" (number->string 1295 36) "zz")
(check "number->string bignum radix 16" (number->string (expt 2 80) 16) "100000000000000000000")
(check "number->string ratio radix 2" (number->string 1/2 2) "1/10")
(check "number->string radix 0" (raises? (lambda () (number->string 10 0))) #t)
(check "number->string radix 1" (raises? (lambda () (number->string 10 1))) #t)
(check "number->string radix 37" (raises? (lambda () (number->string 10 37))) #t)
(check "number->string radix 100" (raises? (lambda () (number->string 10 100))) #t)
(check "number->string radix -5" (raises? (lambda () (number->string 10 -5))) #t)
(check "number->string bignum radix 100" (raises? (lambda () (number->string (expt 10 30) 100))) #t)
(check "number->string bignum radix 1" (raises? (lambda () (number->string (expt 10 30) 1))) #t)
(check "number->string ratio radix 99" (raises? (lambda () (number->string 1/3 99))) #t)
(check "number->string radix a string" (raises? (lambda () (number->string 10 "x"))) #t)
(check "number->string radix 2.0" (raises? (lambda () (number->string 10 2.0))) #t)
(check "round trip in every radix"
       (let loop ((r 2))
         (cond ((> r 36) #t)
               ((not (= (s->n (number->string 123456789 r) r) 123456789)) r)
               ((not (= (s->n (number->string (- (expt 7 40)) r) r) (- (expt 7 40)))) (list 'big r))
               (else (loop (+ r 1)))))
       #t)
(check "the notation symbols still work for number->string" (number->string 60 'neugebauer) "1,0")

;;; ---- from the review: quaternion terms went to strtod unchecked ----
(check "quaternion: a space in a term" (s->n "1+ 5k") #f)
(check "quaternion: a space after the sign" (s->n "+ 5k") #f)
(check "quaternion: a tab" (s->n "1+\t2j+3k") #f)
(check "quaternion: 0x in a term" (s->n "1+0x10k") #f)
(check "quaternion: a C hex float in a term" (s->n "1+0x1p3k") #f)
(check "quaternion: inf" (s->n "1+infk") #f)
(check "quaternion: nan" (s->n "nan+1k") #f)
(check "quaternion: nan with a suffix" (s->n "1+nan(1)k") #f)
(check "nank is a symbol" (symbol? 'nank) #t)
(check "infk is a symbol" (symbol? 'infk) #t)
(check "inf+k is a symbol" (symbol? 'inf+k) #t)
(check "quaternion: an exponent with no digits" (s->n "1e+k") #f)
(check "quaternion: two points" (s->n "1.2.3k") #f)
(check "4k is still a quaternion" (s->n "4k") (make-quaternion 0 0 0 4))
(check "1+2i+3j+4k" (s->n "1+2i+3j+4k") (make-quaternion 1 2 3 4))
(check "+k" (s->n "+k") (make-quaternion 0 0 0 1))
(check "-k" (s->n "-k") (make-quaternion 0 0 0 -1))
(check "1.5e2k" (s->n "1.5e2k") (make-quaternion 0 0 0 150))
(check "1e-2j+k" (s->n "1e-2j+k") (make-quaternion 0 0 0.01 1))
(check ".5k" (s->n ".5k") (make-quaternion 0 0 0 0.5))
(check "negative terms" (s->n "-1.5-2.5i-3.5j-4.5k") (make-quaternion -1.5 -2.5 -3.5 -4.5))

;;; ---- a radix prefix on something that is not a number is a read error ----
(define (rd s) (guard (e (#t 'read-error)) (read (open-input-string s))))
(check "#x0x10 in source" (rd "#x0x10") 'read-error)
(check "#xzz in source" (rd "#xzz") 'read-error)
(check "#b2 in source" (rd "#b2") 'read-error)
(check "#o9 in source" (rd "#o9") 'read-error)
(check "#d1a in source" (rd "#d1a") 'read-error)
(check "#x followed by a space" (rd "#x 10") 'read-error)
(check "#x alone" (rd "#x") 'read-error)
(check "#x10 still reads" (rd "(#x10 #b11 #o17 #d10 #xFF #d1.5 #x#e10)") '(16 3 15 10 255 1.5 16))
(check "string->number still gives #f, not an error" (s->n "#xzz") #f)

;;; ---- more from the review ----
(check "an embedded NUL with a notation symbol"
       (s->n (string #\1 #\2 (integer->char 0) #\3) 'neugebauer) #f)
(check "radix 33: x is not a digit" (s->n "0x10" 33) #f)
(check "radix 33: w is the last digit" (s->n "w" 33) 32)
(check "radix 34: x is a digit" (s->n "x" 34) 33)
(check "radix 34: 0x10 is a number" (s->n "0x10" 34) 38182)
(check "a vertical tab" (s->n "\x0b;5") #f)
(check "a form feed" (s->n "\x0c;5") #f)
(check "a carriage return" (s->n "\r5") #f)
(check "a no-break space" (s->n "\xa0;5") #f)
(check "a space inside a bignum" (s->n "1 00000000000000000000") #f)
(check "a space after a bignum" (s->n "100000000000000000000 ") #f)
(check "a newline after the sign of a bignum" (s->n "-\n100000000000000000000") #f)
(check "-0" (s->n "-0") 0)
(check "0." (s->n "0.") 0.0)
(check ".0" (s->n ".0") 0.0)
(check "0+0i" (s->n "0+0i") 0)
(check "a bignum with leading zeros" (s->n "000100000000000000000000") (expt 10 20))
(check "0x and -0x1 are symbols that read back"
       (map (lambda (s) (let ((v (rd s))) (and (symbol? v) (symbol->string v)))) '("0x" "-0x1" "0xdeadbeef"))
       '("0x" "-0x1" "0xdeadbeef"))
(check "number->string of a flonum ignores a valid radix (as before)" (number->string 1.5 2) "1.5")

(newline)
(display pass) (display " passed, ") (display fail) (display " failed")
(newline)
(if (> fail 0) (exit 1) (exit 0))
