# Writes ${OUT} (build_dynamic.h): the build date and git state for SRFI-176.
# Run at every build as a custom target; see CMakeLists.txt.
#
# Inputs: SRC_DIR (source tree), OUT (header to write), INFO_PATHS (true to
# include the names of changed files, CURRY_BUILD_INFO_PATHS in CMakeLists.txt).
#
# The header is rewritten only when its content other than the date
# changes, so version_info.c is not recompiled on every build. A property
# that cannot be determined (no git, source tarball, detached HEAD for the
# branch) is left out; version_info.c checks the CURRY_HAVE_* macros.

set(MAX_MODIFIED 100)

function(c_string out value)
  string(REPLACE "\\" "\\\\" v "${value}")
  string(REPLACE "\"" "\\\"" v "${v}")
  string(REPLACE "\n" " " v "${v}")
  string(REPLACE "\r" " " v "${v}")
  string(REPLACE "?" "\\?" v "${v}")   # no trigraphs (??/) in the C source
  # Undo the protection applied to ; [ ] while a value was held in a list.
  string(REPLACE "<SEMI>" ";" v "${v}")
  string(REPLACE "<LB>" "[" v "${v}")
  string(REPLACE "<RB>" "]" v "${v}")
  set(${out} "\"${v}\"" PARENT_SCOPE)
endfunction()

function(git_run out)
  execute_process(
    COMMAND git --no-optional-locks -c core.quotePath=false -C "${SRC_DIR}" ${ARGN}
    OUTPUT_VARIABLE o ERROR_QUIET RESULT_VARIABLE rc
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(rc EQUAL 0)
    set(${out} "${o}" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

function(render out date)
  set(body "/* Generated by cmake/BuildInfo.cmake at build time. Do not edit. */\n")
  string(APPEND body "#define CURRY_BUILD_DATE \"${date}\"\n")
  # Only use git state when SRC_DIR is itself the top of a work tree. A source
  # tarball unpacked inside some other repository must not report that
  # repository's commit.
  git_run(toplevel rev-parse --show-toplevel)
  if(NOT "${toplevel}" STREQUAL "")
    get_filename_component(toplevel "${toplevel}" REALPATH)
  endif()
  get_filename_component(src_real "${SRC_DIR}" REALPATH)
  set(commit "")
  if(toplevel STREQUAL src_real)
    git_run(commit rev-parse HEAD)
  endif()
  if(NOT "${commit}" STREQUAL "")
    c_string(q "${commit}")
    string(APPEND body "#define CURRY_HAVE_GIT 1\n#define CURRY_BUILD_GIT_COMMIT ${q}\n")
    git_run(branch rev-parse --abbrev-ref HEAD)
    if(NOT "${branch}" STREQUAL "" AND NOT "${branch}" STREQUAL "HEAD")
      c_string(q "${branch}")
      string(APPEND body "#define CURRY_BUILD_GIT_BRANCH ${q}\n")
    endif()
    git_run(tag describe --tags --exact-match HEAD)
    if(NOT "${tag}" STREQUAL "")
      c_string(q "${tag}")
      string(APPEND body "#define CURRY_BUILD_GIT_TAG ${q}\n")
    endif()
    # Paths of changed tracked and untracked files, without the status letters.
    git_run(status status --porcelain --untracked-files=normal)
    # Paths may contain ; [ ] which a CMake list would split or merge, so
    # protect them first and split on newlines only.
    string(REPLACE ";" "<SEMI>" status "${status}")
    string(REPLACE "[" "<LB>" status "${status}")
    string(REPLACE "]" "<RB>" status "${status}")
    string(REGEX MATCHALL "[^\n]+" lines "${status}")
    set(items "")
    set(n 0)
    foreach(line IN LISTS lines)
      if(line STREQUAL "")
        continue()
      endif()
      if(n GREATER_EQUAL MAX_MODIFIED)
        break()
      endif()
      string(LENGTH "${line}" line_len)
      if(line_len LESS 4)
        continue()
      endif()
      string(SUBSTRING "${line}" 3 -1 path)
      # A rename is reported as "old -> new"; keep the new name.
      string(FIND "${path}" " -> " arrow)
      if(NOT arrow EQUAL -1)
        math(EXPR arrow "${arrow} + 4")
        string(SUBSTRING "${path}" ${arrow} -1 path)
      endif()
      # git quotes some names (spaces, unusual characters); drop the quotes.
      if(path MATCHES "^\"(.*)\"$")
        set(path "${CMAKE_MATCH_1}")
      endif()
      c_string(q "${path}")
      string(APPEND items "    ${q},\n")
      math(EXPR n "${n} + 1")
    endforeach()
    if(NOT INFO_PATHS)
      set(items "")   # file names are build-machine information; see CMakeLists.txt
    endif()
    string(APPEND body "static const char *const curry_build_git_modified[] = {\n${items}    NULL\n};\n")
  endif()
  set(${out} "${body}" PARENT_SCOPE)
endfunction()

# string(TIMESTAMP) uses SOURCE_DATE_EPOCH when it is set (reproducible builds).
string(TIMESTAMP now "%Y-%m-%dT%H:%M:%SZ" UTC)

# Keep the old date when nothing else changed.
set(date "${now}")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  string(REGEX MATCH "CURRY_BUILD_DATE \"([^\"]*)\"" _ "${old}")
  if(CMAKE_MATCH_1)
    render(candidate "${CMAKE_MATCH_1}")
    if(candidate STREQUAL old)
      return()
    endif()
  endif()
endif()
render(content "${date}")
file(WRITE "${OUT}" "${content}")
