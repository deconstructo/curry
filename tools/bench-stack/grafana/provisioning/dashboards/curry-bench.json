{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Curry Scheme GC benchmark telemetry — live view of the current run",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "id": 100,
      "type": "row",
      "title": "Current run — results per benchmark (populates as tests complete)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "table",
      "title": "Results so far this run",
      "description": "Each row appears when a benchmark finishes and publishes its result. Refreshes every 5 s.",
      "datasource": { "type": "influxdb", "uid": "P951FEA4DE68E13C5" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [ { "displayName": "Time", "desc": false } ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "displayMode": "auto" },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "mean" },
            "properties": [
              { "id": "displayName", "value": "mean (ms)" },
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 110 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 100 },
                { "color": "orange", "value": 500 },
                { "color": "red", "value": 1000 }
              ]}},
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [
              { "id": "displayName", "value": "p99 (ms)" },
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "stddev" },
            "properties": [
              { "id": "displayName", "value": "±stddev" },
              { "id": "unit", "value": "ms" },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "gc_major_count" },
            "properties": [
              { "id": "displayName", "value": "major GC" },
              { "id": "custom.width", "value": 90 },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 50 },
                { "color": "red", "value": 200 }
              ]}},
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "gc_minor_count" },
            "properties": [
              { "id": "displayName", "value": "minor GC" },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "gc_heap_bytes" },
            "properties": [
              { "id": "displayName", "value": "heap" },
              { "id": "unit", "value": "bytes" },
              { "id": "custom.width", "value": 100 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "benchmark" },
            "properties": [ { "id": "custom.width", "value": 200 } ]
          },
          {
            "matcher": { "id": "byName", "options": "mode" },
            "properties": [ { "id": "custom.width", "value": 60 } ]
          },
          {
            "matcher": { "id": "byName", "options": "gc" },
            "properties": [ { "id": "custom.width", "value": 100 } ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "P951FEA4DE68E13C5" },
          "refId": "A",
          "query": "import \"date\"\nfrom(bucket: \"benchmarks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"event\"] == \"result\" and (r[\"_field\"] == \"mean\" or r[\"_field\"] == \"p99\" or r[\"_field\"] == \"stddev\" or r[\"_field\"] == \"gc_major_count\" or r[\"_field\"] == \"gc_minor_count\" or r[\"_field\"] == \"gc_heap_bytes\"))\n  |> group(columns: [\"benchmark\", \"mode\", \"gc\", \"_field\"])\n  |> last()\n  |> map(fn: (r) => ({ r with _time: date.truncate(t: r._time, unit: 1s), _value: float(v: r._value) }))\n  |> group(columns: [\"benchmark\", \"mode\", \"gc\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"benchmark\", \"mode\", \"gc\", \"mean\", \"p99\", \"stddev\", \"gc_major_count\", \"gc_minor_count\", \"gc_heap_bytes\"])"
        }
      ]
    },
    {
