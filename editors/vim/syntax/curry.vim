" R7RS identifier characters (excludes , ; ' ` ")
syn iskeyword 33,36-38,42-43,45-58,60-64,65-90,94-95,97-122,126

" ---- comments -------------------------------------------------
syn match   curryComment /;.*$/ contains=@Spell
