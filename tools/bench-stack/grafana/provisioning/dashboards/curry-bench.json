{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Curry Scheme GC benchmark telemetry — real-time view of bench.scm results",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Mean time per benchmark (ms)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb" },
          "refId": "A",
          "query": "from(bucket: \"benchmarks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"_field\"] == \"mean\" and r[\"event\"] == \"result\")\n  |> map(fn: (r) => ({ r with _field: r.benchmark + \"/\" + r.gc + \"/\" + r.mode }))\n  |> group(columns: [\"_field\"])"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p99 latency (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "boehm" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "generational" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "influxdb" },
          "refId": "A",
          "query": "from(bucket: \"benchmarks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"_field\"] == \"p99\" and r[\"event\"] == \"result\")\n  |> map(fn: (r) => ({ r with _field: r.benchmark + \"/\" + r.gc }))\n  |> group(columns: [\"_field\"])"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Minor GC count per run",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb" },
          "refId": "A",
          "query": "from(bucket: \"benchmarks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"_field\"] == \"gc_minor_count\" and r[\"event\"] == \"result\")\n  |> map(fn: (r) => ({ r with _field: r.benchmark + \"/\" + r.gc }))\n  |> group(columns: [\"_field\"])"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Max minor GC pause (µs)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb" },
          "refId": "A",
          "query": "from(bucket: \"benchmarks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"_field\"] == \"gc_minor_max_us\" and r[\"event\"] == \"result\")\n  |> last()"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "GC p99 pause (µs)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb" },
          "refId": "A",
          "query": "from(bucket: \"benchmarks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"_field\"] == \"gc_p99_us\" and r[\"event\"] == \"result\")\n  |> last()"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last major GC count",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "targets": [
        {
          "datasource": { "type": "influxdb" },
          "refId": "A",
          "query": "from(bucket: \"benchmarks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"_field\"] == \"gc_major_count\" and r[\"event\"] == \"result\")\n  |> last()"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Latest results — boehm vs generational",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "options": {
        "sortBy": [ { "displayName": "benchmark", "desc": false } ],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "mean" },
            "properties": [
              { "id": "unit", "value": "ms" },
              { "id": "decimals", "value": 2 }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "influxdb" },
          "refId": "A",
          "query": "from(bucket: \"benchmarks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"_field\"] == \"mean\" and r[\"event\"] == \"result\")\n  |> group(columns: [\"benchmark\", \"gc\", \"mode\"])\n  |> last()\n  |> pivot(rowKey: [\"benchmark\", \"mode\"], columnKey: [\"gc\"], valueColumn: \"_value\")"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["curry", "gc", "benchmark"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Curry Bench",
  "uid": "curry-bench-01",
  "version": 1
}
