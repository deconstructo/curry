;; do / 𒄿
(check "SF cunei: 𒄿 (do)"
  (𒄿 ((i 0 (+ i 1)) (s 0 (+ s i)))
      ((= i 5) s))
  10)

;; spawn / 𒅁𒀀 — cuneiform
(𒁹 cunei-sem (make-semaphore 0))
(𒁹 cunei-spawn-result #f)
(𒅁𒀀 (𒇽 ()
  (𒁀𒀀 cunei-spawn-result (𒈧𒁹 7 7))
  (sem-post! cunei-sem)))
(sem-wait! cunei-sem)
(check "SF cunei: 𒅁𒀀 (spawn) runs body" cunei-spawn-result 49)

