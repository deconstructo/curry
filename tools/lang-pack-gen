#!/usr/bin/env curry
;;; tools/lang-pack-gen — Generate a Curry language pack from a CSV file.
;;;
;;; Usage:
;;;   curry tools/lang-pack-gen \
;;;     --id warlpiri \
;;;     --display-name "Warlpiri (Yapa)" \
;;;     --intro "Yapa yimi Warlpiri kurlangu!" \
;;;     --error-preamble "Ngurra-kurlu karlipa yimi:" \
;;;     --csv warlpiri.csv \
;;;     --output langs/warlpiri.scm
;;;
;;; CSV format (header row required):
;;;   indigenous_name,english_canonical,description
;;;   yirdi,lambda,pattern / way of doing
;;;   nyinaja,define,give a name to
;;;   ...
;;; The description column is optional.

(import (scheme base)
        (scheme file)
        (scheme read)
        (scheme write)
        (curry getopt))

(define args (getopt command-line-args
               '(("id"              required-argument "Language identifier")
                 ("display-name"    required-argument "Display name (e.g. \"Warlpiri (Yapa)\")")
                 ("intro"           optional-argument "Intro text shown on activation")
                 ("error-preamble"  optional-argument "Prefix for error messages")
                 ("csv"             required-argument "Input CSV file path")
                 ("output"          optional-argument "Output .scm path (default: stdout)"))))

(define (opt key default)
  (let ((p (assoc key args)))
    (if p (cdr p) default)))

(define id           (opt "id" #f))
(define display-name (opt "display-name" id))
(define intro        (opt "intro" ""))
(define error-pre    (opt "error-preamble" ""))
(define csv-path     (opt "csv" #f))
(define out-path     (opt "output" #f))

(when (not id)    (error "lang-pack-gen: --id is required"))
(when (not csv-path) (error "lang-pack-gen: --csv is required"))

;;; Parse CSV
(define (parse-csv path)
  (define port (open-input-file path))
  (define (read-line* p)
    (let loop ((chars '()))
      (let ((c (read-char p)))
        (cond
          ((eof-object? c) (if (null? chars) c (list->string (reverse chars))))
          ((char=? c #\newline) (list->string (reverse chars)))
          (else (loop (cons c chars)))))))
  (define (split-csv-line line)
    (let loop ((chars (string->list line)) (field '()) (fields '()))
      (cond
        ((null? chars) (reverse (cons (list->string (reverse field)) fields)))
        ((char=? (car chars) #\,)
         (loop (cdr chars) '() (cons (list->string (reverse field)) fields)))
        (else (loop (cdr chars) (cons (car chars) field) fields)))))
  ;; skip header
  (read-line* port)
  (let loop ((mappings '()))
    (let ((line (read-line* port)))
      (if (eof-object? line)
          (begin (close-input-port port) (reverse mappings))
          (let ((cols (split-csv-line line)))
            (if (< (length cols) 2)
                (loop mappings)
                (let* ((foreign (string->symbol (string-trim (list-ref cols 0))))
                       (canon   (string->symbol (string-trim (list-ref cols 1))))
                       (desc    (if (>= (length cols) 3)
                                    (string-trim (list-ref cols 2))
                                    ""))
                       (entry   (if (string=? desc "")
                                    (list foreign canon)
                                    (list foreign canon desc))))
                  (loop (cons entry mappings)))))))))

(define (string-trim s)
  (let* ((chars (string->list s))
         (trimmed (let loop ((cs chars))
                    (if (or (null? cs) (not (char-whitespace? (car cs))))
                        cs
                        (loop (cdr cs)))))
         (rev (let loop ((cs (reverse trimmed)))
                (if (or (null? cs) (not (char-whitespace? (car cs))))
                    cs
                    (loop (cdr cs))))))
    (list->string (reverse rev))))

(define mappings (parse-csv csv-path))

;;; Emit .scm
(define (emit-pack port)
  (define (w . args) (for-each (lambda (s) (write-string s port)) args))
  (w ";;; " id ".scm — " display-name " language pack for Curry Scheme.\n")
  (w ";;; Generated by tools/lang-pack-gen\n\n")
  (w "(import (curry lang))\n\n")
  (w "(register-language!\n")
  (w "  `((id           . \"" id "\")\n")
  (w "    (display-name . \"" display-name "\")\n")
  (w "    (intro        . \"" intro "\")\n")
  (w "    (error-preamble . \"" error-pre "\")\n")
  (w "    (mappings     .\n")
  (for-each
    (lambda (m)
      (let ((foreign (symbol->string (car m)))
            (canon   (symbol->string (cadr m)))
            (desc    (if (null? (cddr m)) "" (caddr m))))
        (if (string=? desc "")
            (w "      (" foreign " " canon ")\n")
            (w "      (" foreign " " canon " \"" desc "\")\n"))))
    mappings)
  (w "      )))\n\n")
  (w ";; Activate with:\n")
  (w ";; (set-active-language! \"" id "\")\n"))

(if out-path
    (call-with-port (open-output-file out-path)
      (lambda (p)
        (emit-pack p)
        (display "Written: " (current-error-port))
        (display out-path (current-error-port))
        (newline (current-error-port))))
    (emit-pack (current-output-port)))
