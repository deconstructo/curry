;;; SRFI-166 (Monadic Formatting) tests: the examples of the specification
;;; for every library, plus the places this port differs from or extends
;;; the reference (column splitting, trimming wide text, cuneiform and
;;; Akkadian text, the SRFI-272 `show` bridge).
;;; https://srfi.schemers.org/srfi-166/

(import (scheme base) (scheme write) (srfi 166)
        (prefix (srfi 272 show) ps:)
        (prefix (srfi srfi-272 show) psa:)
        (prefix (srfi srfi-166) a:)
        (prefix (srfi srfi-166 base) ab:)
        (prefix (srfi srfi-166 pretty) ap:)
        (prefix (srfi srfi-166 columnar) ac:)
        (prefix (srfi srfi-166 unicode) au:)
        (prefix (srfi srfi-166 color) acl:))

(define pass-count 0)
(define fail-count 0)
(define (t name got want)
  (if (equal? got want)
      (set! pass-count (+ pass-count 1))
      (begin
        (set! fail-count (+ fail-count 1))
        (display "FAIL: ") (display name)
        (display " got=") (write got)
        (display " want=") (write want) (newline))))

(t "pi" (show #f "π = " (with ((precision 2)) (acos -1)) nl) "π = 3.14\n")
(t "each" (show #f (each "a" "b")) "ab")
(t "nothing" (show #f "a" nothing "b") "ab")
(t "written pair" (show #f (written (cons 0 1))) "(0 . 1)")
(t "prec 1.5" (show #f 1.5 " " (with ((precision 0)) 1.5)) "1.5 2")
(t "1/7" (show #f 1/7 " " (with ((precision 3)) 1/7) " " (with ((precision 20)) 1/7)) "1/7 0.143 0.14285714285714285714")
(t "escaped plain" (show #f (escaped "hi, bob!")) "hi, bob!")
(t "escaped quote" (show #f (escaped "hi, \"bob!\"")) "hi, \\\"bob!\\\"")
(t "maybe-escaped 1" (show #f (maybe-escaped "foo" char-whitespace? #\")) "foo")
(t "maybe-escaped 2" (show #f (maybe-escaped "foo bar" char-whitespace? #\")) "\"foo bar\"")
(t "maybe-escaped 3" (show #f (maybe-escaped "foo\"bar\"baz" char-whitespace? #\")) "\"foo\\\"bar\\\"baz\"")
(t "comma" (show #f (numeric/comma 123456789)) "123,456,789")
(t "comma 2" (show #f (numeric/comma 123456789 2)) "1,23,45,67,89")
(t "comma (3 2)" (show #f (numeric/comma 123456789 '(3 2))) "12,34,56,789")
(t "si 608" (show #f (numeric/si 608)) "608")
(t "si 608B" (show #f (numeric/si 608) "B") "608B")
(t "si sep" (show #f (numeric/si 608 1000 " ") "B") "608 B")
(t "si 3986" (show #f (numeric/si 3986)) "4k")
(t "si 1024" (show #f (numeric/si 3986 1024) "B") "3.9KiB")
(t "si micro" (show #f (numeric/si 1.23e-6) "m") "1.2µm")
(t "si micro sep" (show #f (numeric/si 1.23e-6 1000 " ") "m") "1.2 µm")
(t "fitted 1" (show #f (with ((precision 2)) (numeric/fitted 4 1.25))) "1.25")
(t "fitted 2" (show #f (with ((precision 2)) (numeric/fitted 4 12.345))) "#.##")
(t "fitted 3" (show #f (with ((precision 0)) (numeric/fitted 2 123.45))) "##")
(t "fl 1" (show #f fl) "")
(t "fl 2" (show #f "hi" fl) "hi\n")
(t "fl 3" (show #f "hi" nl fl) "hi\n")
(t "space-to" (show #f "a" (space-to 5) "b") "a    b")
(t "space-to 0" (show #f "a" (space-to 0) "b") "ab")
(t "tab-to 1" (show #f (tab-to 5) "b") "b")
(t "tab-to 2" (show #f "a" (tab-to 5) "b") "a    b")
(t "tab-to 3" (show #f "abcdefghi" (tab-to 5) "b") "abcdefghi b")
(t "joined" (show #f (joined displayed '(a b c) ", ")) "a, b, c")
(t "joined/prefix" (show #f (joined/prefix displayed '(usr local bin) "/")) "/usr/local/bin")
(t "joined/suffix" (show #f (joined/suffix displayed '(1 2 3) nl)) "1\n2\n3\n")
(t "joined/last" (show #f (joined/last displayed (lambda (l) (each "and " l)) '(lions tigers bears) ", ")) "lions, tigers, and bears")
(t "joined/dot" (show #f "(" (joined/dot displayed (lambda (d) (each ". " d)) '(1 2 . 3) " ") ")") "(1 2 . 3)")
(t "joined/range" (show #f (joined/range displayed 0 5 " ")) "0 1 2 3 4")
(t "padded" (show #f (padded 5 "abc")) "  abc")
(t "padded/right" (show #f (padded/right 5 "abc")) "abc  ")
(t "padded/both" (show #f (padded/both 5 "abc")) " abc ")
(t "trimmed 1" (show #f (trimmed 5 "abcde")) "abcde")
(t "trimmed 2" (show #f (trimmed 5 "abcdef")) "bcdef")
(t "trimmed/right" (show #f (trimmed/right 5 "abcdef")) "abcde")
(t "trimmed/both 5" (show #f (trimmed/both 5 "abcdef")) "abcde")
(t "trimmed/both 4" (show #f (trimmed/both 4 "abcdef")) "bcde")
(t "ell left" (show #f (with ((ellipsis "...")) (trimmed 5 "abcdef"))) "...ef")
(t "ell right" (show #f (with ((ellipsis "...")) (trimmed/right 5 "abcdef"))) "ab...")
(t "ell both _" (show #f (with ((ellipsis "_")) (trimmed/both 5 "abcdef"))) "_bcd_")
(t "ell both …" (show #f (with ((ellipsis "…")) (trimmed/both 5 "abcdef"))) "…bcd…")
(t "fn col" (show #f "abcdefgh" (fn (col) col)) "abcdefgh8")
(t "fitted" (show #f (fitted 5 "abc") "|" (fitted 3 "abcdef")) "  abc|def")
(t "lazy" (show #f (trimmed/lazy 5 (joined/range displayed 0 #f " "))) "0 1 2")
(t "with!" (show #f (with ((radix 16)) (each (with! (radix 2)) 5))) "101")
(t "forked" (show #f (forked (with! (radix 2)) "x") 5) "x5")
(t "call-with-output" (show #f (call-with-output "abc" (lambda (s) (each (string-length s) "!")))) "3!")
(t "radix 16" (show #f (with ((radix 16)) 255)) "ff")
(t "sign" (show #f (numeric -1.99 10 2 '("(" . ")"))) "(1.99)")
(t "plus" (show #f (numeric 5 10 #f #t)) "+5")
(t "written list nums" (show #f (with ((precision 1)) (written '(1.25 2.5)))) "(1.2 2.5)")
(t "columnar" (show #f (with ((width 16)) (columnar (displayed "abc\ndef\n") (displayed "123\n456\n"))))
   "abc     123\ndef     456\n")
(t "columnar borders" (show #f (with ((width 15)) (columnar "/* " (displayed "abc\ndef\n") " | " (displayed "123\n456\n") " */")))
   "/* abc | 123 */\n/* def | 456 */\n")
(t "tabular" (show #f (tabular "|" (each "a\nbc\ndef\n") "|" (each "123\n45\n6\n") "|"))
   "|a  |123|\n|bc |45 |\n|def|6  |\n")
(t "wrapped" (show #f (with ((width 20)) (wrapped "the quick brown fox jumps over the lazy dog")))
   "the quick brown fox\njumps over the lazy\ndog")
(t "justified" (show #f (with ((width 20)) (justified "the quick brown fox jumps over the lazy dog")))
   "the  quick brown fox\njumps  over the lazy\ndog")
(t "wrapped/char" (show #f (with ((width 4)) (wrapped/char "abcdefghij"))) "abcd\nefgh\nij")
(t "infinite" (show #f (columnar 4 'right 'infinite (line-numbers) " " (displayed "a\nb\nc\n")))
   "   1 a\n   2 b\n   3 c\n")
(t "widths" (show #f (with ((width 10)) (columnar 3 (displayed "ab\ncd\n") (displayed "x\ny\n")))) "ab x\ncd y\n")
(t "right just" (show #f (columnar 5 'right (displayed "ab\n") "|")) "   ab|\n")
(t "center just" (show #f (columnar 6 'center (displayed "ab\n") "|")) "  ab  |\n")
(t "pretty" (show #f (with ((width 30)) (pretty '(define (f x) (display x) (newline) (+ x 1)))))
   "(define (f x)\n  (display x)\n  (newline)\n  (+ x 1))")
(t "pretty col" (show #f "ab " (with ((width 30)) (pretty '(define (f x) (display x) (newline) (+ x 1)))))
   "ab (define (f x)\n     (display x)\n     (newline)\n     (+ x 1))")
(t "pretty-simply" (show #f (pretty-simply '(a b))) "(a b)")
(t "terminal-aware 1" (show #f (with ((pad-char #\〜)) (padded/both 5 "日本語"))) "〜日本語〜")
(t "terminal-aware 2" (show #f (terminal-aware (with ((pad-char #\〜)) (padded/both 5 "日本語")))) "日本語")
(t "term width" (list (string-terminal-width "日本語") (string-terminal-width "a\x1b;[31mb\x1b;[0m") (string-terminal-width "e\x301;")) '(6 2 1))
(t "term width wide" (string-terminal-width/wide "α") 2)
(t "cuneiform width" (string-terminal-width "𒀭𒂗") 2)
(t "sub 1" (substring-terminal-width "ａｂｃ" 0 6) "ａｂｃ")
(t "sub 2" (substring-terminal-width "ａｂｃ" 0 4) "ａｂ")
(t "sub 3" (substring-terminal-width "ａｂｃ" 2 6) "ｂｃ")
(t "sub 4" (substring-terminal-width "ａｂｃ" 1 4) "ａｂ")
(t "sub 5" (substring-terminal-width "ａｂｃ" 1 5) "ａｂ")
(t "sub 6" (substring-terminal-width "ａｂｃ" 2 4) "ｂ")
(t "sub 7" (substring-terminal-width "ａｂｃ" 2 3) "")
(t "sub 8" (substring-terminal-width "ａｂｃ" -1 2) "ａ")
(t "preserve" (substring-terminal-preserve "a\x1b;[31mb") "\x1b;[31m")
(t "upcased" (show #f (upcased "abc")) "ABC")
(t "downcased sigma" (show #f (downcased "ΜΈΛΟΣ")) "μέλος")
(t "upcased ansi" (show #f (upcased "a\x1b;[31mb")) "A\x1b;[31mB")
(t "as-red" (show #f (as-red "x")) "\x1b;[31mx\x1b;[39m")
(t "as-bold" (show #f (as-bold "x")) "\x1b;[1mx\x1b;[22m")
(t "as-color" (show #f (as-color 5 0 0 "x")) "\x1b;[38;5;196mx\x1b;[39m")
(t "on-true-color" (show #f (on-true-color 1 2 3 "x")) "\x1b;[48;2;1;2;3mx\x1b;[49m")
(t "pretty color" (> (string-length (show #f (pretty-with-color '(define x "s")))) 14) #t)
(t "terminal-aware trim" (show #f (terminal-aware (trimmed 3 "日本語"))) "語")

;; ── Cuneiform, Akkadian, and wide text ──────────────────────────────────
(t "cuneiform pads by columns (1 each)" (show #f (terminal-aware (padded 5 "𒀭𒂗"))) "   𒀭𒂗")
(t "cuneiform trims by columns" (show #f (terminal-aware (trimmed/right 2 "𒀭𒂗𒀭"))) "𒀭𒂗")
(t "Akkadian transliteration width" (show #f (terminal-aware (padded 8 "ḫiṭītu"))) "  ḫiṭītu")
(t "combining mark takes no column" (show #f (terminal-aware (padded 3 (string #\e #\x301)))) (string #\space #\space #\e #\x301))
(t "emoji is two columns" (show #f (terminal-aware (padded 4 "🙂"))) "  🙂")
(t "wide trimmed does not overshoot" (show #f (terminal-aware (trimmed 3 "日本語"))) "語")
(t "wide trimmed both sides" (show #f (terminal-aware (trimmed/both 4 "日本語"))) "日本")
(t "columnar with wide cells" (show #f (terminal-aware (columnar 6 (displayed "日本\n") "|" (displayed "x\n"))))
   "日本  |x\n")
(t "show a cuneiform symbol" (show #f 'ḫiṭītu) "ḫiṭītu")
(t "show a list with cuneiform" (show #f '(𒀭 "𒂗")) "(𒀭 \"𒂗\")")
(t "string-terminal-width with ANSI" (string-terminal-width "\x1b;[31m日\x1b;[0m") 2)
(t "ambiguous is wide" (string-terminal-width/wide "αβ") 4)
(t "terminal-aware honors ambiguous-is-wide?"
   (show #f (with ((ambiguous-is-wide? #t)) (terminal-aware (padded 4 "α")))) "  α")

;; ── State variables ─────────────────────────────────────────────────────
(let ((v (make-state-variable "mine" 7)))
  (t "custom state variable default" (show #f (fn ((x v)) x)) "7")
  (t "custom state variable with" (show #f (with ((v 9)) (fn ((x v)) x))) "9")
  (t "with is restored" (show #f (with ((v 9)) nothing) (fn ((x v)) x)) "7"))
(let ((v (make-state-variable "fixed" 1 #t)))
  (t "immutable cannot be with!" (guard (e (#t 'error)) (show #f (with! (v 2)))) 'error)
  (t "immutable can be bound by with" (show #f (with ((v 2)) (fn ((x v)) x))) "2"))
(t "row" (show #f "a" nl "b" nl (fn (row) row)) "a\nb\n2")
(t "col after newline" (show #f "abc" nl "de" (fn (col) col)) "abc\nde2")

;; ── Numbers ─────────────────────────────────────────────────────────────
(t "numeric radix 2" (show #f (numeric 10 2)) "1010")
(t "numeric negative" (show #f (numeric -42)) "-42")
(t "numeric precision rounds half to even" (show #f (numeric 2.5 10 0)) "2")
(t "numeric comma and precision" (show #f (numeric 1234567.891 10 2 #f 3)) "1,234,567.89")
(t "numeric comma-sep and decimal-sep" (show #f (numeric 1234.5 10 1 #f 3 #\. #\,)) "1.234,5")
(t "numeric/si 1.5M" (show #f (numeric/si 1500000)) "1.5M")
(t "numeric/si rounds up a prefix" (show #f (numeric/si 999999)) "1M")
(t "numeric/si negative" (show #f (numeric/si -2500)) "-2.5k")
(t "numeric of a NaN" (show #f (numeric (/ 0. 0.))) "+nan.0")
(t "written nested radix" (show #f (with ((radix 16)) (written '(255 (16))))) "(ff (10))")
(t "written string in list" (show #f (written '("a" #\b))) "(\"a\" #\\b)")
(t "written circular" (show #f (written (let ((c (list 1 2))) (set-cdr! (cdr c) c) c))) "#0=(1 2 . #0#)")
(t "written-shared" (show #f (written-shared (let ((s (list 1))) (list s s)))) "(#0=(1) #0#)")
(t "displayed string and char" (show #f (displayed "a") (displayed #\b)) "ab")
(t "displayed a procedure is an error" (guard (e (#t 'error)) (show #f (displayed car))) 'error)
(t "show to a port" (let ((p (open-output-string))) (show p "x" 1) (get-output-string p)) "x1")

;; ── Layout ──────────────────────────────────────────────────────────────
(t "forked keeps position" (show #f (forked (with! (radix 2)) "ab") (fn (col) col)) "ab2")
(t "wrapped width" (show #f (with ((width 10)) (wrapped "aa bb cc dd ee"))) "aa bb cc\ndd ee")
(t "wrapped/list" (show #f (with ((width 10)) (wrapped/list '("aa" "bb" "cc" "dd" "ee")))) "aa bb cc\ndd ee")
(t "wrapped long word" (show #f (with ((width 4)) (wrapped "abcdefgh ij"))) "abcdefgh\nij")
(t "tabular fixed width" (show #f (tabular 3 (each "a\nb\n") (each "x\nyy\n"))) "a  x\nb  yy\n")
(t "columnar literal borders only" (show #f (columnar "--")) "--\n")
(t "columnar no columns" (show #f (columnar)) "\n")
(t "columnar uneven columns" (show #f (with ((width 8)) (columnar (each "a\nb\nc\n") (each "x\n"))))
   "a   x\nb   \nc   \n")
(t "fraction width" (show #f (with ((width 20)) (columnar 0.5 (each "a\n") (each "b\n")))) "a         b\n")

;; ── Pretty ──────────────────────────────────────────────────────────────
(t "pretty circular" (show #f (pretty (let ((c (list 1 2))) (set-cdr! (cdr c) c) c))) "#0=(1 2 . #0#)")
(t "pretty uses width" (show #f (with ((width 12)) (pretty '(define (f x) (g x))))) "(define (f x)\n  (g x))")
(t "pretty with radix" (show #f (with ((radix 16)) (pretty '(255)))) "(ff)")

;; ── (srfi 272 show): the pretty printer as a 166 formatter ─────────────
(t "pprinted prints a form" (show #f (ps:pprinted '(define (f x) x))) "(define (f x) x)")
(t "pprinted uses the width state variable"
   (show #f (with ((width 14)) (ps:pprinted '(define (f x) (g x) (h x)))))
   "(define (f x)\n  (g x)\n  (h x))")
(t "width overrides pp-width"
   (show #f (with ((width 14)) (ps:pprinted '(define (f x) (g x) (h x)) 'pp-width 200)))
   "(define (f x)\n  (g x)\n  (h x))")
(t "pprinted keyword arguments" (show #f (ps:pprinted '(a (b (c))) 'pp-level 1)) "(a ...)")
(t "pprinted*" (show #f (ps:pprinted* '(a (b (c))) '(pp-level 1))) "(a ...)")
(t "pprinted indents to the column"
   (show #f "xx " (with ((width 20)) (ps:pprinted '(define (f x) (g x) (h x)))))
   "xx (define (f x)\n     (g x)\n     (h x))")
(t "pprinted with cuneiform head" (show #f (with ((width 14)) (ps:pprinted '(𒁹 (f x) (g x) (h x)))))
   "(𒁹 (f x)\n  (g x)\n  (h x))")
(t "pp parameters are re-exported" (ps:pp-width) 79)

;; ── Alternate-name libraries (srfi srfi-166 ...) ────────────────────────
(t "alias composite" (a:show #f "x" (a:padded 3 "y")) "x  y")
(t "alias base macros" (ab:show #f (ab:with ((ab:radix 2)) 5)) "101")
(t "alias fn macro" (ab:show #f "ab" (ab:fn (ab:col) ab:col)) "ab2")
(t "alias pretty" (ab:show #f (ap:pretty '(a b))) "(a b)")
(t "alias columnar" (ab:show #f (ac:wrapped "a b")) "a b")
(t "alias unicode" (au:string-terminal-width "日") 2)
(t "alias color" (ab:show #f (acl:as-red "x")) "\x1b;[31mx\x1b;[39m")
(t "alias show" (ab:show #f (psa:pprinted '(a b))) "(a b)")

;; ── Review fixes ────────────────────────────────────────────────────────
(t "string-terminal-width/wide takes a range" (string-terminal-width/wide "abcdef" 1 3) 2)
(t "negative rounding to zero has no sign" (show #f (numeric -0.001 10 2)) "0.00")
(t "negative keeps its sign when not zero" (show #f (numeric -0.006 10 2)) "-0.01")
(t "unterminated ANSI is not a sequence" (string-terminal-width "a\x1b;[1;2 ") 6)
(t "overlong word does not distort wrapping"
   (show #f (with ((width 5)) (wrapped "a bbbbbbbbbbbbbbbbbbbbbbbb c d e f")))
   "a\nbbbbbbbbbbbbbbbbbbbbbbbb\nc d e\nf")
(t "wide /wide variant in a range" (string-terminal-width/wide "αβγδ" 1 3) 4)

(display "SRFI-166 tests: ") (display pass-count) (display " passed, ")
(display fail-count) (display " failed") (newline)
(if (> fail-count 0) (exit 1))
