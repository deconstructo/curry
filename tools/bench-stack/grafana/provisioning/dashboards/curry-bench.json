          "refId": "A",
          "query": "import \"date\"\nfrom(bucket: \"benchmarks\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"mqtt_consumer\" and r[\"event\"] == \"profile\" and (r[\"_field\"] == \"calls\" or r[\"_field\"] == \"total_ns\" or r[\"_field\"] == \"mean_us\"))\n  |> group(columns: [\"benchmark\", \"fn_name\", \"_field\"])\n  |> last()\n  |> map(fn: (r) => ({ r with _time: date.truncate(t: r._time, unit: 1s), _value: float(v: r._value) }))\n  |> group(columns: [\"benchmark\", \"fn_name\"])\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"_time\", \"benchmark\", \"fn_name\", \"calls\", \"total_ns\", \"mean_us\"])"
