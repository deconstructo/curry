(check "SF cunei: 𒅁𒌋 (let*)" (𒅁𒌋 ((a 3) (b (+ a 1))) b) 4)

;; quote / 𒆠𒈠
(check "SF cunei: 𒆠𒈠 (quote)" (𒆠𒈠 foo) 'foo)

;; quasiquote / 𒆠𒈠𒅁 — Akkadian name for quasiquote; use , for unquote
(𒁹 cunei-qq-val 99)
(check "SF cunei: 𒆠𒈠𒅁 (quasiquote) with reader , unquote"
